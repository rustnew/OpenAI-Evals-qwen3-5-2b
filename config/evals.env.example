# Copy to evals.env and fill in the gateway API key. Never commit evals.env.
# Endpoint: the AI gateway (OpenAI-compatible), model qwen3-5-2b-local.
# ⚠️ VERIFIED LIVE (2026-09-09): the gateway serves OpenAI paths under /v1 —
# a bare https://api.ai.camer.digital returns "unsupported path".
OPENAI_BASE_URL=https://api.ai.camer.digital/v1
OPENAI_API_KEY=REPLACE_WITH_GATEWAY_KEY
EVALS_MODEL=qwen3-5-2b-local
# Sampling pinned per the study protocol (baseline condition = server defaults).
# Override per condition when running root-cause experiments.
# Ticket 4 root-cause sampling factors — leave unset for the baseline
# (server default is applied; the value is recorded as null per run).
EVALS_TEMPERATURE=1.0
EVALS_MAX_TOKENS=512
EVALS_SEED=42
# EVALS_CONDITION=temp-0.2    # root-cause condition label, recorded per row + summary
# EVALS_FINGERPRINT=a8f5e028   # deployment config fingerprint (re-baseline attribution)
# EVALS_TOP_P=0.9          # optional — top-p sampling (one factor at a time)
# EVALS_TOP_K=20           # optional — top-k sampling (one factor at a time)
# EVALS_THINKING=false     # optional — Qwen3.5 reasoning mode (true/false)
