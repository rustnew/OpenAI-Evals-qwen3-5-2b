# Copy to evals.env and fill in the gateway API key. Never commit evals.env.
# Endpoint: the AI gateway (OpenAI-compatible), model qwen3-5-2b-local.
OPENAI_BASE_URL=https://api.ai.camer.digital
OPENAI_API_KEY=REPLACE_WITH_GATEWAY_KEY
EVALS_MODEL=qwen3-5-2b-local
# Sampling pinned per the study protocol (baseline condition = server defaults).
# Override per condition when running root-cause experiments.
EVALS_TEMPERATURE=1.0
EVALS_MAX_TOKENS=512
EVALS_SEED=42
